<Project Sdk="Microsoft.NET.Sdk">

    <!-- Generates ts/generated-record (MemoryPackGenerator_TypeScriptDictionaryAsRecord=true).
         map/TypeScriptBench.Map.csproj compiles the same Models.cs into ts/generated-map with the
         default Map emission. See README.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="map/**;ts/**" />
        <None Remove="map/**;ts/**" />
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptOutputDirectory" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptImportExtension" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptConvertPropertyName" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptEnableNullableTypes" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptDictionaryAsRecord" />
        <CompilerVisibleProperty Include="DesignTimeBuild" />
    </ItemGroup>
    <!-- Same settings as Flare.Api, plus DictionaryAsRecord. -->
    <PropertyGroup>
        <MemoryPackGenerator_TypeScriptOutputDirectory>$(MSBuildProjectDirectory)/ts/generated-record</MemoryPackGenerator_TypeScriptOutputDirectory>
        <MemoryPackGenerator_TypeScriptImportExtension>.js</MemoryPackGenerator_TypeScriptImportExtension>
        <MemoryPackGenerator_TypeScriptConvertPropertyName>true</MemoryPackGenerator_TypeScriptConvertPropertyName>
        <MemoryPackGenerator_TypeScriptEnableNullableTypes>false</MemoryPackGenerator_TypeScriptEnableNullableTypes>
        <MemoryPackGenerator_TypeScriptDictionaryAsRecord>true</MemoryPackGenerator_TypeScriptDictionaryAsRecord>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MemoryPack.Core\MemoryPack.Core.csproj" />
        <ProjectReference Include="..\..\src\MemoryPack.Generator\MemoryPack.Generator.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

</Project>
