{
	"name": "memorypack-typescript-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "dotnet build .. -clp:ErrorsOnly && dotnet build ../map/TypeScriptBench.Map.csproj -clp:ErrorsOnly",
		"fixtures": "tsx make-fixtures.ts && dotnet run --project .. --no-build -- fixtures",
		"roundtrip": "tsx roundtrip.ts",
		"bench": "tsx run-interleaved.ts",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"tinybench": "6.2.2",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
